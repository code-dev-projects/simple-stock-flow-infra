# Copy this file to .env and fill in whatever is left empty.
# The real .env is never versioned: the entries below are keys, not secrets.

# --- Database ----------------------------------------------------------------
# These three values are all a client needs to connect. The port is published to
# the host only under the development profile (see README).
POSTGRES_DB=simple_stock_flow
POSTGRES_USER=simple_stock_flow
POSTGRES_PASSWORD=

# --- Token signing -----------------------------------------------------------
# At least 32 characters. It has no default on purpose: when it is missing the
# API must refuse to start instead of signing with a filler key.
JWT_SIGNING_KEY=

# --- First administrator -----------------------------------------------------
# The service reads these as Bootstrap__AdminUsername/AdminPassword and creates this
# administrator on the first start, which is the only way into the system afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Published port ----------------------------------------------------------
# The only port the system exposes to the host. The API and the database stay inside.
PORTAL_PORT=8080

# --- API documentation -------------------------------------------------------
# Leave it unset and Swagger is mounted: /swagger on the service, and /swagger through the
# portal. It is on because the browsable API is part of what this exercise delivers, not
# because production wants it -- a real deployment sets this to false and the page disappears.
# It changes nothing else: no endpoint appears or vanishes with it.
SWAGGER_ENABLED=true

# --- Demonstration seller ----------------------------------------------------
# A seller-role account created by the seeder in simple-stock-flow-tools, so the screen can
# show what a seller CANNOT do: no new-product button, and 403 when the API is called directly.
# Nothing here needs it to start; without it the seeder stops and says so.
DEMO_SELLER_PASSWORD=
